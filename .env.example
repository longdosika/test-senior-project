# Copy to .env.local (git-ignored) and fill in. Never commit real keys.

# --- PostgreSQL & API ---
DATABASE_URL=postgres://user:password@localhost:5432/senior_project
PORT=4000
CORS_ORIGIN=http://localhost:3000
# Comma-separated emails that become admin on registration
ADMIN_EMAILS=
UPLOAD_DIR=./uploads

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI / ML (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Payments (Omise, Thailand) ---
OMISE_SECRET_KEY=

# --- LINE Messaging API ---
LINE_CHANNEL_ACCESS_TOKEN=

# --- Web Push (VAPID). Generate with: npx web-push generate-vapid-keys ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Tests (optional): run server/db/postgres.integration.test.ts against a disposable DB ---
# TEST_DATABASE_URL=postgres://user:password@localhost:5432/senior_test
